{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EnjoyableWork/mcp-doctor/blob/main/schemas/mcp-doctor.aggregate.v1.schema.json",
  "title": "mcp-doctor stable diagnostic aggregate",
  "description": "The redacted, vendor-neutral mcp-doctor.aggregate/v1 contract. Members are normalized stable reports addressed only by zero-based input ordinal. Unknown optional aggregate properties are compatible within v1 and must be ignored.",
  "type": "object",
  "required": [
    "schema_version",
    "schema_stability",
    "outcome",
    "exit_code",
    "limits",
    "summary",
    "members"
  ],
  "properties": {
    "schema_version": {
      "const": "mcp-doctor.aggregate/v1"
    },
    "schema_stability": {
      "const": "stable"
    },
    "outcome": {
      "enum": [
        "passed",
        "failed",
        "incomplete"
      ]
    },
    "exit_code": {
      "type": "integer",
      "enum": [
        0,
        1,
        3
      ]
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/member"
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "outcome": {
          "const": "passed"
        },
        "exit_code": {
          "const": 0
        }
      }
    },
    {
      "properties": {
        "outcome": {
          "const": "failed"
        },
        "exit_code": {
          "const": 1
        }
      }
    },
    {
      "properties": {
        "outcome": {
          "const": "incomplete"
        },
        "exit_code": {
          "const": 3
        }
      }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32
    },
    "limits": {
      "type": "object",
      "required": [
        "input_files",
        "input_file_bytes",
        "input_bytes",
        "json_depth",
        "json_nodes",
        "validation_work",
        "checks",
        "findings",
        "rendered_bytes",
        "total_ms",
        "retries",
        "concurrency"
      ],
      "properties": {
        "input_files": {
          "const": 32
        },
        "input_file_bytes": {
          "const": 4194304
        },
        "input_bytes": {
          "const": 16777216
        },
        "json_depth": {
          "const": 64
        },
        "json_nodes": {
          "const": 1000000
        },
        "validation_work": {
          "const": 1000000
        },
        "checks": {
          "const": 4096
        },
        "findings": {
          "const": 2048
        },
        "rendered_bytes": {
          "const": 8388608
        },
        "total_ms": {
          "const": 10000
        },
        "retries": {
          "const": 0
        },
        "concurrency": {
          "const": 1
        }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "members",
        "passed",
        "failed",
        "incomplete"
      ],
      "properties": {
        "members": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "passed": {
          "$ref": "#/$defs/count"
        },
        "failed": {
          "$ref": "#/$defs/count"
        },
        "incomplete": {
          "$ref": "#/$defs/count"
        }
      },
      "additionalProperties": true
    },
    "member": {
      "type": "object",
      "required": [
        "ordinal",
        "report"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "report": {
          "$ref": "https://github.com/EnjoyableWork/mcp-doctor/blob/main/schemas/mcp-doctor.report.v1.schema.json"
        }
      },
      "additionalProperties": true
    }
  }
}
