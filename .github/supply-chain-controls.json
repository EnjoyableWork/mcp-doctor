{
  "schema_version": "mcp-doctor.supply-chain-controls/v1",
  "api_version": "2026-03-10",
  "reviewed_on": "2026-08-13",
  "repository": "EnjoyableWork/mcp-doctor",
  "default_branch": "main",
  "dependency_updates": {
    "configuration": ".github/dependabot.yml",
    "ecosystems": [
      {
        "name": "cargo",
        "directory": "/",
        "schedule": "weekly",
        "version_group": "cargo-version-updates",
        "security_group": "cargo-security-updates"
      },
      {
        "name": "github-actions",
        "directory": "/",
        "schedule": "weekly",
        "version_group": "github-actions-version-updates",
        "security_group": "github-actions-security-updates"
      }
    ],
    "auto_merge": false,
    "exact_direct_requirements": true,
    "locked_graph": true,
    "review_dimensions": [
      "release_notes_and_behavior",
      "maintenance_and_security_response",
      "ownership_and_provenance",
      "manifest_and_lockfile_diff",
      "selected_features",
      "transitive_graph_and_duplicate_versions",
      "licenses_and_sources",
      "advisories",
      "unsafe_code_and_build_scripts",
      "minimum_rust_and_supported_platforms",
      "build_binary_startup_and_runtime_cost",
      "focused_and_native_behavior"
    ]
  },
