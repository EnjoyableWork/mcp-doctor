  "github_actions_policy": {
    "enabled": true,
    "allowed_actions": "selected",
    "sha_pinning_required": true,
    "github_owned_allowed": true,
    "verified_allowed": false,
    "patterns_allowed": [
      "Homebrew/actions/*@*",
      "rust-lang/crates-io-auth-action@*"
    ],
    "default_workflow_permissions": "read",
    "can_approve_pull_request_reviews": false,
    "fork_pull_request_approval_policy": "first_time_contributors"
  },
  "workflow_inventory": {
    "checked_in": [
      ".github/workflows/ci.yml",
      ".github/workflows/compatibility.yml",
      ".github/workflows/release-authorization-negative.yml",
      ".github/workflows/release-channels.yml",
      ".github/workflows/release-preflight.yml",
      ".github/workflows/release.yml"
    ],
    "provider_managed": [
      {
        "name": "Dependabot Updates",
        "path": "dynamic/dependabot/dependabot-updates",
        "boundary": "GitHub-managed proposal service configured by .github/dependabot.yml; it has no repository merge or review-approval authority"
      },
      {
        "name": "CodeQL",
        "path": "dynamic/github-code-scanning/codeql",
        "boundary": "GitHub-managed default setup verified by MCPD-014; it performs static analysis without a repository-selected Action ref and GitHub documents that other public-Action restriction policies do not govern this dynamic workflow"
      }
    ]
  },
  "untrusted_workflows": [
    {
      "path": ".github/workflows/ci.yml",
      "event": "pull_request",
      "permissions": {
        "contents": "read"
      },
      "github_hosted_only": true,
      "stored_secrets": false,
      "privileged_assets": false
    },
    {
      "path": ".github/workflows/release-preflight.yml",
      "event": "pull_request",
      "permissions": {
        "contents": "read"
      },
      "github_hosted_only": true,
      "stored_secrets": false,
      "privileged_assets": false
    }
  ],
